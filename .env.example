# Copy to .env and fill in real values. Never commit .env.
# See docs/BACKEND_ARCHITECTURE.md §10 and buildPlan.md §91 for context.

# --- MongoDB (buildPlan.md §93: Atlas free-tier dev cluster) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/prism

# --- Redis / BullMQ queue (buildPlan.md §93: Upstash free-tier) ---
REDIS_URL=redis://default:password@host:6379

# --- Qdrant vector DB (buildPlan.md §93: Qdrant Cloud free-tier) ---
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=

# --- Object storage (buildPlan.md §5.1: AWS S3) ---
S3_ENDPOINT=
S3_BUCKET=prism-resumes-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Provider selection (buildPlan.md §5.7) ---
# Dev: gemini/gemini. Prod: claude/openai.
EXTRACTION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth (buildPlan.md §5.6: NextAuth v5 + Credentials) ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Logging (optional, defaults to debug in dev / info in prod) ---
LOG_LEVEL=
