# Copy to .env and fill in real values. Never commit .env.
# See docs/BACKEND_ARCHITECTURE.md §10 and buildPlan.md §91, §115a for context.

# --- MongoDB (buildPlan.md §93: persistent local Docker container in dev) ---
# docker run -d --name prism-mongo -p 27017:27017 --restart unless-stopped mongo:7.0
MONGODB_URI=mongodb://localhost:27017/prism?directConnection=true

# --- Redis / BullMQ queue (buildPlan.md §93: persistent local Docker container in dev) ---
# docker run -d --name prism-redis -p 6380:6379 --restart unless-stopped redis:7-alpine
# (use a different host port than 6380 if it's already taken on your machine)
REDIS_URL=redis://localhost:6380

# --- Vector store: Pinecone (buildPlan.md §115a — active vector store,
# architected as swappable; Qdrant is a documented future option, not built) ---
PINECONE_API_KEY=
PINECONE_INDEX=prism-index

# --- Object storage (buildPlan.md §5.1: AWS S3) ---
AWS_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Provider selection (buildPlan.md §5.7) ---
# Dev: gemini/gemini. Prod: claude/openai (deferred until the Gemini path is proven out).
EXTRACTION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth (buildPlan.md §5.6: NextAuth v5 + Credentials) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Logging (optional, defaults to debug in dev / info in prod) ---
LOG_LEVEL=

# --- Email / SMTP (feature 27g: forgot/reset password) ---
# Unset in dev/CI: password reset links are logged via ConsoleEmailProvider
# instead of sent, so local development never needs real SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Absolute origin embedded in password-reset email links.
APP_BASE_URL=http://localhost:3000
